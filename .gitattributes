# Store text with LF and check it out with LF on every platform, so the Mac and
# Windows working trees match byte for byte.
* text=auto eol=lf

# Windows scripts keep CRLF: cmd.exe misreads some LF-only .bat files.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# macOS scripts must stay LF or /bin/sh fails on the \r.
*.command text eol=lf
*.sh text eol=lf

# Designer packages and images: never convert or diff.
*.sbs binary
*.sbsar binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.tif binary
*.tiff binary
*.exr binary
*.zip binary
